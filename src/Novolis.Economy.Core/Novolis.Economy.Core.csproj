<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.Economy.Core</PackageId>
    <IsPackable>true</IsPackable>
    <RootNamespace>Novolis.Economy.Core</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Document surface in README/SPEC; enum/member XML can land incrementally. -->
    <NoWarn>$(NoWarn);CS1591;CS1587</NoWarn>
    <Description>
      Bounded-minimum economic kernel: immutable EconomyState, authoritative positions and claims,
      invariant-preserving transactions, valuation, and ordered period transitions.
    </Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Novolis.Economy.Primitives\Novolis.Economy.Primitives.csproj" />
  </ItemGroup>
</Project>

